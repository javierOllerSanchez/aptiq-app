{
  "expo": {
    "name": "Aptiq",
    "slug": "aptiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aptiq",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.javioller.aptiq"
    },
    "android": {
      "package": "com.javioller.aptiq",
      "adaptiveIcon": {
        "backgroundColor": "#121316",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EFEEE9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "./plugins/with-windows-cmake",
      "expo-secure-store",
      "expo-notifications",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "javioller",
    "extra": {
      "eas": {
        "projectId": "ba05ed2f-ae3d-46d5-a725-36db0b99a2b4"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ba05ed2f-ae3d-46d5-a725-36db0b99a2b4"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
